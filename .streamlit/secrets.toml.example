# Copy this file to .streamlit/secrets.toml and fill in your key.
# secrets.toml is gitignored — never commit real keys.
#
# On Streamlit Community Cloud, set these under:
#   App settings → Secrets
#
# Paste the contents below (without the [secrets] wrapper — Streamlit adds that).

GROQ_API_KEY = "your_groq_api_key_here"
